# Copy to .env (in this folder, or one folder above). Never commit the real .env.
PORTKEY_API_KEY=
# Optional: OPENAI_API_KEY is not used by this app.
# Optional price overrides (USD per million tokens) for cost estimates:
# PRICE_INPUT_PER_M=0.10
# PRICE_OUTPUT_PER_M=0.50
# PORT=8000
# Optional: real Google mobile speed test (free key from Google Cloud, enable the PageSpeed Insights API)
# PAGESPEED_API_KEY=
# Fair-use limits (defaults shown). Your own computer is never limited per user.
# DAILY_LIMIT_PER_USER=5
# DAILY_AUDIT_CAP=300
# TRUST_PROXY=1   # set when hosted behind a proxy so each visitor is identified correctly
# RATE_LIMIT_EXEMPT_IPS=127.0.0.1,::1,localhost
